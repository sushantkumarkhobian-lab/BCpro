# =====================================================================
# WALLETTRACE BLOCKCHAIN FORENSICS - CONFIGURATION (.env)
# =====================================================================
# This is the single configuration file for the entire blockchain module.
# Modify the parameters below to customize API keys, performance, and tracing thresholds.
# =====================================================================

# ---------------------------------------------------------------------
# 1. API & INGESTION SETTINGS
# ---------------------------------------------------------------------
# Set to 'true' to run offline with rich realistic mock Tron USDT dataset.
# Set to 'false' to fetch real live transactions from the Tron blockchain.
USE_MOCK_DATA=false

# TronGrid API key (Optional for mock data, recommended for live data to avoid public rate limits).
# Get a free key at: https://www.trongrid.io/
TRONGRID_API_KEY=YOUR_API_KEY_TRON

# Public API endpoints
TRON_GRID_BASE_URL=https://api.trongrid.io
TRONSCAN_BASE_URL=https://apilist.tronscanapi.com/api

# Ingestion limits per wallet query
MAX_TRANSACTIONS_PER_WALLET=50

# ---------------------------------------------------------------------
# 2. GRAPH & TRACING SETTINGS
# ---------------------------------------------------------------------
# Maximum wallet-to-wallet hop depth for fund-flow traversal (Default: 4)
MAX_HOPS=4

# Peel-Chain Flow Ranking Threshold (Percentage of outgoing volume)
# Transactions carrying at least this percentage of total wallet output are flagged as PRIMARY flows.
# Value range: 1.0 to 100.0 (Default: 10.0 = 10%)
FLOW_THRESHOLD_PERCENT=10.0

# Minimum USDT transfer amount to include in graph (Filter out small dust/spam)
MIN_USDT_AMOUNT=1.0

# ---------------------------------------------------------------------
# 3. SERVER & API SETTINGS
# ---------------------------------------------------------------------
# Host and port for FastAPI server
HOST=0.0.0.0
PORT=8000
DEBUG_MODE=true

# ---------------------------------------------------------------------
# 4. ETHEREUM SETTINGS
# ---------------------------------------------------------------------
# Default target chain selection: 'tron' or 'ethereum'
# Note: Addresses starting with '0x' will automatically route to Ethereum regardless of this setting.
TARGET_CHAIN=tron

# Etherscan API key (Optional for mock data, recommended for live Ethereum data).
# Get a free key at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHER_API

# Public Etherscan REST API Base URL
ETHERSCAN_BASE_URL=https://api.etherscan.io/api

# Smart Contract Address for ERC20 USDT on Ethereum Mainnet
USDT_ERC20_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7

